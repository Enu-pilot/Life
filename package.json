{
  "name": "lifeplan",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --exclude tests/unit/performance.test.ts",
    "test:e2e": "playwright test",
    "verify:golden": "python3 -I tools/verify/generate_golden.py"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4",
    "zustand": "^5.0.16",
    "zod": "^4.6.7",
    "idb-keyval": "^6.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "@vitejs/plugin-react": "^6.1.2",
    "vitest": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^29.1.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@testing-library/jest-dom": "^7.0.1",
    "fast-check": "^4.10.2",
    "fake-indexeddb": "^6.2.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/node": "^22.0.0",
    "@playwright/test": "1.63.0"
  }
}
